# Brevo SMTP Configuration (Application Decision Notifications)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=YOUR_ROTATED_BREVO_SMTP_LOGIN
BREVO_SMTP_KEY=YOUR_ROTATED_BREVO_SMTP_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME="Erkab Skills Training Organization"

