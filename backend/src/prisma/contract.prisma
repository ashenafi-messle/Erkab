// use prisma-8

model TrainingProgram {
  id                  String               @id
  slug                String               @unique
  title               String
  category            String
  duration            String
  delivery            String
  scholarship         Boolean              @default(true)
  image               String
  imageAlt            String
  summary             String
  description         String
  skills              String
  modules             String
  careerPaths         String
  prerequisites       String
  isPublished         Boolean              @default(true)
  studentApplications StudentApplication[]
  createdAt           TimestamptzString    @default(now())
  updatedAt           temporal.updatedAtString()
}

model StudentApplication {
  id                  String                @id
  referenceNumber     String                @unique
  fullName            String
  gender              String
  age                 Int
  classCompletionYear String
  telegramPhone       String
  email               String
  status              String                @default("PENDING")
  programId           String
  program             TrainingProgram       @relation(fields: [programId], references: [id])
  documents           ApplicationDocument[]
  reviews             ApplicationReview[]
  createdAt           TimestamptzString     @default(now())
  updatedAt           temporal.updatedAtString()
}

model TrainerApplication {
  id                String                @id
  referenceNumber   String                @unique
  fullName          String
  email             String
  telegramPhone     String
  expertiseTrack    String
  yearsOfExperience String
  portfolioUrl      String?
  teachingStatement String
  status            String                @default("PENDING")
  documents         ApplicationDocument[]
  reviews           ApplicationReview[]
  createdAt         TimestamptzString     @default(now())
  updatedAt         temporal.updatedAtString()
}

model TutorApplication {
  id                     String                @id
  referenceNumber        String                @unique
  studentOrApplicantName String
  parentOrContactPhone   String
  email                  String?
  gradeLevel             String
  subjects               String
  deliveryPreference     String
  locationDetails        String?
  qualifications         String?
  experience             String?
  hourlyRate             String?
  status                 String                @default("PENDING")
  documents              ApplicationDocument[]
  reviews                ApplicationReview[]
  payments               TutoringPayment[]
  createdAt              TimestamptzString     @default(now())
  updatedAt              temporal.updatedAtString()
}

model TutoringPayment {
  id                 String            @id
  paymentReference   String            @unique
  tutorApplicationId String
  tutorApplication   TutorApplication  @relation(fields: [tutorApplicationId], references: [id])
  amount             Int
  currency           String            @default("ETB")
  status             String            @default("PENDING")
  paymentMode        String            @default("DEMO")
  transactionId      String?           @unique
  receiptUrl         String?
  receiptSubmittedAt TimestamptzString?
  verifiedBy         String?
  verifiedByName     String?
  verifiedAt         TimestamptzString?
  rejectionReason    String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}

model ApplicationDocument {
  id                     String              @id
  category               String
  originalFilename       String
  fileType               String
  fileSize               Int
  cloudinaryPublicId     String
  cloudinarySecureUrl    String
  cloudinaryResourceType String              @default("raw")
  cloudinaryDeliveryType String              @default("authenticated")
  studentApplicationId   String?
  studentApplication     StudentApplication? @relation(fields: [studentApplicationId], references: [id])
  trainerApplicationId   String?
  trainerApplication     TrainerApplication? @relation(fields: [trainerApplicationId], references: [id])
  tutorApplicationId     String?
  tutorApplication       TutorApplication?   @relation(fields: [tutorApplicationId], references: [id])
  partnershipRequestId   String?
  partnershipRequest     PartnershipRequest? @relation(fields: [partnershipRequestId], references: [id])
  createdAt              TimestamptzString   @default(now())
}

model ApplicationReview {
  id                   String              @id
  reviewerId           String
  reviewerName         String
  decision             String
  notes                String?
  studentApplicationId String?
  studentApplication   StudentApplication? @relation(fields: [studentApplicationId], references: [id])
  trainerApplicationId String?
  trainerApplication   TrainerApplication? @relation(fields: [trainerApplicationId], references: [id])
  tutorApplicationId   String?
  tutorApplication     TutorApplication?   @relation(fields: [tutorApplicationId], references: [id])
  createdAt            TimestamptzString   @default(now())
}

model PartnershipRequest {
  id               String                @id
  reference        String                @unique
  organizationName String
  organizationType String
  contactPerson    String
  email            String
  phone            String
  country          String?
  city             String?
  partnershipType  String
  proposal         String
  status           String                @default("PENDING")
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       TimestamptzString?
  documents        ApplicationDocument[]
  createdAt        TimestamptzString     @default(now())
  updatedAt        temporal.updatedAtString()
}

model DonationCampaign {
  id              String            @id
  slug            String            @unique
  title           String
  description     String
  imageAssetId    String?
  imageUrl        String?
  goalAmountMinor Int?
  currency        String            @default("ETB")
  isPublished     Boolean           @default(true)
  startsAt        TimestamptzString?
  endsAt          TimestamptzString?
  donations       Donation[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Donation {
  id          String            @id
  reference   String            @unique
  campaignId  String?
  campaign    DonationCampaign? @relation(fields: [campaignId], references: [id])
  donorName   String?
  email       String
  phone       String?
  isAnonymous Boolean           @default(false)
  amountMinor Int
  currency    String            @default("ETB")
  message     String?
  status      String            @default("PENDING_PAYMENT")
  payments    DonationPayment[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model DonationPayment {
  id                    String            @id
  reference             String            @unique
  donationId            String
  donation              Donation          @relation(fields: [donationId], references: [id])
  provider              String            @default("DEMO")
  mode                  String            @default("DEMO")
  amountMinor           Int
  currency              String            @default("ETB")
  status                String            @default("PENDING")
  idempotencyKey        String?           @unique
  providerTransactionId String?           @unique
  failureCode           String?
  failureMessage        String?
  verifiedAt            TimestamptzString?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

model NewsArticle {
  id                String             @id
  slug              String             @unique
  title             String
  excerpt           String
  content           String
  coverImageAssetId String?
  coverImageUrl     String?
  category          String             @default("General")
  status            String             @default("DRAFT")
  publishedAt       TimestamptzString?
  authorName        String?
  images            NewsArticleImage[]
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()
}

model NewsArticleImage {
  id                 String            @id
  articleId          String
  article            NewsArticle       @relation(fields: [articleId], references: [id])
  imageUrl           String
  cloudinaryPublicId String?
  caption            String?
  displayOrder       Int               @default(0)
  createdAt          TimestamptzString @default(now())
}

model AdminUser {
  id           String            @id
  email        String            @unique
  passwordHash String
  name         String
  role         String            @default("SUB_ADMIN")
  permissions  String            @default("[]")
  status       String            @default("ACTIVE")
  lastLoginAt  TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model AdminAuditLog {
  id          String            @id
  adminUserId String?
  adminName   String
  action      String
  resource    String
  details     String?
  ipAddress   String?
  createdAt   TimestamptzString @default(now())
}

model SupportTicket {
  id            String            @id
  ticketNumber  String            @unique
  requesterName String
  email         String
  category      String            @default("GENERAL")
  subject       String
  message       String
  status        String            @default("OPEN")
  priority      String            @default("NORMAL")
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model SystemIncident {
  id          String            @id
  title       String
  service     String
  severity    String            @default("MEDIUM")
  status      String            @default("INVESTIGATING")
  description String
  resolvedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model ApplicationNotification {
  id               String            @id
  applicationType  String
  applicationId    String
  referenceNumber  String
  recipientName    String
  recipientEmail   String
  decision         String
  notificationType String
  status           String            @default("PENDING")
  attempts         Int               @default(0)
  maxAttempts      Int               @default(3)
  lastAttemptAt    TimestamptzString?
  sentAt           TimestamptzString?
  errorMessage     String?
  idempotencyKey   String?           @unique
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()
}

model ContactMessage {
  id                 String             @id
  referenceCode      String             @unique
  fullName           String
  email              String
  phone              String?
  subject            String
  category           String             @default("GENERAL_INQUIRY")
  message            String
  status             String             @default("NEW")
  priority           String             @default("NORMAL")
  assignedAdminId    String?
  internalNotes      String?
  readAt             TimestamptzString?
  resolvedAt         TimestamptzString?
  resolvedByAdminId  String?
  createdAt          TimestamptzString  @default(now())
  updatedAt          temporal.updatedAtString()
}


