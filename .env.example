# ==============================================================================
# Erkab EdTech Platform - Production Environment Configuration Template
# Target: Zergaw Cloud VPS (CS02004: 2 vCPU / 4 GB RAM / Ubuntu 24.04 LTS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Baked into Next.js client bundles)
# ------------------------------------------------------------------------------
# Public Website API Origin (without trailing slash or path prefix)
NEXT_PUBLIC_WEBSITE_API_URL=https://api.erkab.org

# Admin Portal API Endpoint (must include /api/v1)
NEXT_PUBLIC_ADMIN_API_URL=https://api.erkab.org/api/v1

# ------------------------------------------------------------------------------
# 2. BACKEND CORE & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=https://erkab.org,https://www.erkab.org,https://admin.erkab.org

# Session & Token Signing Secret (generate with: openssl rand -base64 48)
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Neon Serverless PostgreSQL or Managed Postgres)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (e.g. Neon pgbouncer pooled URL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/erkab_db?sslmode=require&connect_timeout=15

# Direct connection string for Prisma CLI migrations (bypasses transaction pooler)
DIRECT_URL=postgresql://username:password@ep-sample.region.aws.neon.tech/erkab_db?sslmode=require

# ------------------------------------------------------------------------------
# 4. CLOUDINARY CDN & FILE STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 5. BREVO SMTP EMAIL RELAY (Transactional Notifications & Decisions)
# ------------------------------------------------------------------------------
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_api_key
BREVO_SENDER_EMAIL=notifications@erkab.org
BREVO_SENDER_NAME="Erkab Skills Training Organization"

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN SEEDING (Used on first deployment only)
# ------------------------------------------------------------------------------
SEED_SUPERADMIN_PASSWORD=REPLACE_WITH_SECURE_INITIAL_SUPERADMIN_PASSWORD
SEED_SUBADMIN_PASSWORD=REPLACE_WITH_SECURE_INITIAL_SUBADMIN_PASSWORD

# ------------------------------------------------------------------------------
# 7. DOMAIN & REVERSE PROXY SETTINGS
# ------------------------------------------------------------------------------
DOMAIN_NAME=erkab.org
WWW_DOMAIN_NAME=www.erkab.org
ADMIN_DOMAIN_NAME=admin.erkab.org
API_DOMAIN_NAME=api.erkab.org
LETSENCRYPT_EMAIL=admin@erkab.org
